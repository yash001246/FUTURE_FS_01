# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/crm
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
CLIENT_URL=http://localhost:5173
# Public form submissions (your website's contact form) authenticate with this
# shared key instead of a JWT, so the public site never gets an admin token.
LEAD_INTAKE_KEY=change_this_intake_key
